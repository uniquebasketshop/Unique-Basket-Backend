# UNIQUE BASKET backend — example environment (copy to .env and fill in real values).
# Never commit .env. Placeholders below are NOT secrets.

# development | test | production. Missing/unknown is treated as production
# (no 1234 OTP bypass, strict secret checks). Use "development" locally.
NODE_ENV=development
# Static test OTP 1234: only when NODE_ENV is development/test AND this is true (D-004).
# The server refuses to start with this set outside development/test. Never set it on a live server.
OTP_BYPASS_ENABLED=true
PORT=5001

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/unique_basket?schema=public

# JWT secrets (required). Outside development/test: >= 32 chars and different from each other.
JWT_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret

# HTTP (P3-03). Comma-separated browser origins allowed to call the API (admin panel).
# Unset: any origin in development/test, none in production.
CORS_ORIGINS=http://localhost:5173
# Reverse-proxy hops in front of the API (e.g. 1) so client IPs are correct.
TRUST_PROXY=
BODY_LIMIT=100kb

# Dev/test seed admin passwords (optional; defaults are well-known dev values)
SEED_SUPER_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
# The seed only runs on a database on this machine. For a non-local dev/test database, set its name here.
SEED_CONFIRM_DATABASE=

# Payment provider: Cashfree (D-020). Leave the two keys empty for cash only.
# Cashfree dashboard → Developers → API Keys (use the Test/Sandbox keys while testing).
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# sandbox while testing, production with live keys (required outside development/test)
CASHFREE_ENV=sandbox
# Optional; default 2023-08-01
CASHFREE_API_VERSION=
# Public https:// address of this API, e.g. https://api.uniquebasket.com (Cashfree webhooks).
# Required in production; locally leave empty (payment is confirmed by the status check).
PUBLIC_API_BASE_URL=

# Login OTP SMS: MSG91 (D-026). Required outside development/test.
# MSG91 → API → Auth key (allow this server's IP, or turn off IP security for local testing),
# and the ID of your DLT-approved OTP template (its text must contain ##OTP##).
# To test real SMS locally: fill both and set OTP_BYPASS_ENABLED=false, then restart.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Notification provider is UNDECIDED (P4-06). Existing Firebase code reads (stringified JSON):
FIREBASE_SERVICE_ACCOUNT=
